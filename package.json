    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.3",
    "next": "16.2.5",
    "oauth-1.0a": "^2.2.6",
    "playwright": "^1.60.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
