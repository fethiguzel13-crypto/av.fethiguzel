<?xml version="1.0" encoding="utf-8"?>
<!--
  DİKKAT — GALAXY:* işaretleri arasındaki bloklar scripts/build-flavor.mjs
  tarafından her flavor için yeniden üretilir. Elle düzenlerseniz bir sonraki
  `npm run galaxy` çalışmasında kaybolur. Kalıcı değişiklik için jeneratörü
  düzenleyin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- GALAXY:DEEPLINKS:START -->
            <!-- ÜRETİLDİ: icthat — sahiplenilen yollar: /icthat, /yargi-kararlari -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.avfethiguzel.com" android:pathPrefix="/icthat" />
                <data android:scheme="https" android:host="www.avfethiguzel.com" android:pathPrefix="/yargi-kararlari" />
                <data android:scheme="https" android:host="avfethiguzel.com" android:pathPrefix="/icthat" />
                <data android:scheme="https" android:host="avfethiguzel.com" android:pathPrefix="/yargi-kararlari" />
            </intent-filter>

            <!-- Uygulamaya özel şema: avfethiguzel-icthat://… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="avfethiguzel-icthat" />
            </intent-filter>
            <!-- GALAXY:DEEPLINKS:END -->

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- GALAXY:PERMISSIONS:START -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- GALAXY:PERMISSIONS:END -->

    <!-- Uygulama yalnız kendi sitesini ve harici bağlantıları sistem
         tarayıcısında açar; başka uygulama sorgulamaz. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
