{
  "name": "fethiguzel-galaxy",
  "version": "2.0.0",
  "description": "Av. Fethi Güzel Hukuk Galaxy — dört Android uygulaması (Play Store)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "build:portal": "node scripts/build-app.mjs --app=portal",
    "build:hesap": "node scripts/build-app.mjs --app=hesap",
    "build:icthat": "node scripts/build-app.mjs --app=icthat",
    "build:rehber": "node scripts/build-app.mjs --app=rehber",
    "dev": "node scripts/build-app.mjs --app=hesap --dev-prepare && vite --config vite.config.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "flavor": "node scripts/build-flavor.mjs",
    "flavor:portal": "node scripts/build-flavor.mjs --app=portal",
    "flavor:hesap": "node scripts/build-flavor.mjs --app=hesap",
    "flavor:icthat": "node scripts/build-flavor.mjs --app=icthat",
    "flavor:rehber": "node scripts/build-flavor.mjs --app=rehber",
    "sync": "npx cap sync android",
    "open:android": "npx cap open android",
    "verify": "node scripts/verify-release.mjs",
    "verify:all": "node scripts/verify-release.mjs --all",
    "aab": "node scripts/build-aab.mjs",
    "test": "node --test \"scripts/__tests__/*.test.mjs\"",
    "release": "node scripts/build-app.mjs && node scripts/generate-icons.mjs && node scripts/verify-release.mjs --all"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/local-notifications": "^7.0.3",
    "@capacitor/network": "^7.0.4",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "fflate": "^0.8.2",
    "lucide-react": "^1.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vite": "^6.0.11"
  }
}
