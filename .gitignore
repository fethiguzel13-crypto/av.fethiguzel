# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Packs live in content-packs/ (git) and are copied to public/ at prebuild.
# Also commit public/content-packs so Vercel always serves şerhler even if prebuild skips.
# public/content-packs/  — DO NOT ignore (empty packs = invisible commentaries)
# Generated at prebuild — do not commit (deploy from build artifact only)
/public/seo-madde/
/public/data/m/
build-out*.txt

# typescript
*.tsbuildinfo
next-env.d.ts

# Scraper artifacts
scraper/node_modules/
/tmp/
*.log

# Editor scratch files
app/mevzuat/Untitled-*.txt

# Twitter startup agent
.tweet-log.json
logs/

# local build noise
start-out.txt

# Yargı kararı yerel arşivi (ağır JSON; Vercel/push öncesi yerelde kalsın)
/data/yargi-kararlari/decisions/
/data/yargi-kararlari/_state/
/data/yargi-kararlari/by-alan/
/data/yargi-kararlari/index.jsonl
/data/yargi-kararlari/index.html


# TestSprite local artifacts
.testsprite/failure/

