    "social:youtube-anim": "node scripts/youtube-animate-render.js",
    "social:youtube-story": "node scripts/youtube-storyboard-render.js",
    "social:youtube-cine": "node scripts/youtube-cinematic-render.js",
    "social:youtube-cast": "node scripts/youtube-cast-cinematic.js",
    "social:daily": "node scripts/startup-social.js",
    "maintenance": "node scripts/startup-maintenance.js",
    "maintenance:tarifeler": "node scripts/check-tarifeler.js",
    "maintenance:weekly": "node scripts/weekly-icthat-digest.js",
