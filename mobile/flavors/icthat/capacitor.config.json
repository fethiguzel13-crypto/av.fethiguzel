{
  "appId": "com.avfethiguzel.icthat",
  "appName": "İçtihat Günü",
  "webDir": "www",
  "server": {
    "url": "https://www.avfethiguzel.com/icthat?app=icthat&lang=tr&utm_source=android_app&utm_medium=icthat",
    "cleartext": false,
    "allowNavigation": [
      "avfethiguzel.com",
      "*.avfethiguzel.com",
      "www.avfethiguzel.com",
      "maps.google.com",
      "*.google.com",
      "play.google.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#1B4F72",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1B4F72"
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#F2F0E9",
    "webContentsDebuggingEnabled": false
  }
}